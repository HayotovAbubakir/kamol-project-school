VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Faqat seed / Telegram bot uchun (brauzerga QO'YILMAYDI) — Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Ota-ona Telegram bot (@BotFather dan)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram ichidagi Mini App uchun deploy qilingan public HTTPS manzil.
# Repo private bo‘lsa GitHub Pages ishlamaydi. Cloudflare Pages / Vercel / Netlify dan public URL ishlatilsin.
TELEGRAM_WEBAPP_URL=

# Cloudflare R2 (fayllar R2 da; foydalanuvchi va topshiriq ma’lumotlari Supabase DB da qoladi)
CF_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_PUBLIC_URL=https://your-r2-public-domain
R2_BUCKET_NAME=kamol-files
