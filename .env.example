# Cloudflare Worker API
CLOUDFLARE_API_URL=https://your-worker.your-subdomain.workers.dev

# Faqat botni qo'lda sozlash uchun; ishlab turgan bot Worker webhook'da
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Lokal Wrangler sinovi uchun maxfiy qiymatlar
AUTH_SECRET=replace-with-a-long-random-secret
BOT_API_SECRET=replace-with-a-different-long-random-secret
MIGRATION_SECRET=replace-with-another-long-random-secret

# Birinchi Owner'ni yaratish uchun, faqat npm run owner:seed paytida
OWNER_SEED_SECRET=
OWNER_SEED_PASSWORD=
OWNER_USERNAME=owner
OWNER_NAME=Kamol School Owner
